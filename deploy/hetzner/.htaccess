# Hernoem dit bestand naar ".htaccess" en plaats het in de document root
# (naast app.fcgi) op Hetzner Webhosting. Stuurt alle requests die geen
# bestaand bestand zijn (dus geen /static/...) door naar de FastCGI-app.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ app.fcgi/$1 [QSA,L]
</IfModule>
