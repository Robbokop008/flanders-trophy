#: routes/main.py:200
msgid "Please fill in all fields correctly (with a valid email address)."
msgstr ""
"Veuillez remplir correctement tous les champs (avec une adresse e-mail "
"valide)."

#: routes/main.py:210
msgid "Your message has been sent successfully."
msgstr "Votre message a été envoyé avec succès."

#: routes/offers.py:74
msgid "Please fill in club, country, contact person and email address."
msgstr ""
"Veuillez indiquer le club, le pays, la personne de contact et l'adresse "
"e-mail."

#: routes/offers.py:76
msgid "Please enter a valid email address."
msgstr "Veuillez saisir une adresse e-mail valide."

#: routes/offers.py:78
msgid "Please fill in at least one team in at least one category."
msgstr "Veuillez indiquer au moins une équipe dans au moins une catégorie."

#: templates/base.html:12
msgid ""
"The biggest international handball tournament in the BeNeLux, held every "
"year in Sint-Truiden."
msgstr ""
"Le plus grand tournoi international de handball du Benelux, organisé "
"chaque année à Sint-Truiden."

#: templates/base.html:104
msgid "International Easter handball tournament in Sint-Truiden."
msgstr "Tournoi international de handball de Pâques à Sint-Truiden."

