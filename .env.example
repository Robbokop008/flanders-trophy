# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# Het .env-bestand zelf hoort NOOIT in git terecht te komen.

SECRET_KEY=verander-dit-in-een-lange-willekeurige-string
# DATABASE_URL laten we standaard leeg: config.py gebruikt dan automatisch
# een absoluut pad naar instance/flanders_trophy.db. Zet deze alleen als je
# een andere database (bv. PostgreSQL in productie) wilt gebruiken.
# DATABASE_URL=postgresql://user:wachtwoord@host/dbnaam

# Mail (contactformulier + offerteaanvragen) - gebruik een Gmail
# app-wachtwoord, niet je gewone wachtwoord. Dit is het account waarmee
# verstuurd wordt.
GMAIL_USER=jouwadres@gmail.com
GMAIL_APP_PASSWORD=...

# Optioneel: laat contactformulier en offerteaanvragen naar verschillende
# adressen versturen. Zonder deze twee velden gaat alles naar GMAIL_USER
# hierboven (zoals voorheen). OFFER_EMAIL mag meerdere adressen bevatten,
# gescheiden door een komma - iedereen daarin krijgt de offerteaanvraag.
CONTACT_EMAIL=info@jouwdomein.be
OFFER_EMAIL=offertes@jouwdomein.be, voorzitter@jouwdomein.be

# Automatische vertaling van CMS-pagina's (titel + inhoud) via DeepL - maak
# een gratis DeepL API-key aan op deepl.com/pro-api. Zonder key blijft alles
# gewoon werken, enkel zonder automatische vertaling (lege taalvelden vallen
# dan terug op Engels, zoals voordien).
DEEPL_API_KEY=...

# Google Analytics-meet-ID (bv. G-XXXXXXXXXX) - optioneel. Zonder deze
# waarde wordt nergens een cookiebanner getoond en laadt Analytics nergens.
# Vul deze pas in NADAT de privacybeleid-pagina (/admin/pages, slug
# "privacy-policy") aangevuld en gepubliceerd is - zie README.md.
GOOGLE_ANALYTICS_ID=

# Vaste canonieke basis-URL voor de <link rel="canonical">-tag (zie
# templates/base.html). Enkel nodig als het domein ooit verandert - config.py
# gebruikt anders al https://flanderstrophy.be als standaardwaarde.
# CANONICAL_BASE_URL=https://flanderstrophy.be
