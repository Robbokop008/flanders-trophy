# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# Het .env-bestand zelf hoort NOOIT in git terecht te komen.

SECRET_KEY=verander-dit-in-een-lange-willekeurige-string
# DATABASE_URL laten we standaard leeg: config.py gebruikt dan automatisch
# een absoluut pad naar instance/flanders_trophy.db. Zet deze alleen als je
# een andere database (bv. PostgreSQL in productie) wilt gebruiken.
# DATABASE_URL=postgresql://user:wachtwoord@host/dbnaam

# Mail (contactformulier) - gebruik een Gmail app-wachtwoord, niet je
# gewone wachtwoord
GMAIL_USER=jouwadres@gmail.com
GMAIL_APP_PASSWORD=...
